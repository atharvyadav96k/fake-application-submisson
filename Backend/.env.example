# ── AI provider (Google Gemini) ────────────────────────────────────────────────
AI_API_KEY=
AI_API_NAME=Default Gemini API Key
AI_API_PROJECT_NAME=
AI_API_PROJECT_NUMBER=
# Model used for session analysis. Flash is fast and cheap; pro is more thorough.
AI_MODEL=gemini-2.5-flash
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_TIMEOUT_MS=30000
# Set false to disable all outbound AI calls (analysis endpoints return 503).
AI_ENABLED=true

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=8080
HOST=127.0.0.1
NODE_ENV=development
LOG_LEVEL=info

# ── Storage (MongoDB / Mongoose) ───────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=activity_verification
# Fail fast instead of buffering commands when Mongo is unreachable.
MONGODB_SERVER_SELECTION_TIMEOUT_MS=8000
MONGODB_MAX_POOL_SIZE=20
# Auto-create indexes at boot. Turn off in production and manage indexes explicitly.
MONGODB_AUTO_INDEX=true

# ── Auth ───────────────────────────────────────────────────────────────────────
# Token the extension sends as `Authorization: Bearer <token>` on ingest endpoints.
INGEST_TOKEN=dev-ingest-token-change-me
# Token for the read/review + AI analysis endpoints.
ADMIN_TOKEN=dev-admin-token-change-me
# Set true only for local development without tokens.
AUTH_DISABLED=false
# Secret used to sign per-user JWTs (frontend + extension login). Required in production.
JWT_SECRET=dev-jwt-secret-change-me
JWT_EXPIRES_IN=7d

# ── Ingest policy ──────────────────────────────────────────────────────────────
SUPPORTED_SCHEMA_VERSIONS=1.0
MAX_EVENTS_PER_BATCH=100
MAX_BODY_BYTES=8388608
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=600

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API (the frontend dashboard).
# Extension service-worker calls do not need CORS when host_permissions are granted.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
