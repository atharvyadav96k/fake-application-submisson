{
  "name": "application-activity-verification-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Ingest, verification and AI-analysis backend for the Application-Activity Verification extension.",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "ai:smoke": "tsx --env-file=.env scripts/ai-smoke.ts",
    "create-admin": "tsx --env-file=.env scripts/create-admin.ts",
    "sync-candidates": "tsx --env-file=.env scripts/sync-candidates.ts",
    "inspect-sessions": "tsx --env-file=.env scripts/inspect-sessions.ts",
    "inspect-ingest-log": "tsx --env-file=.env scripts/inspect-ingest-log.ts",
    "replay-session": "tsx --env-file=.env scripts/replay-session.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
